# Copy to .env and adjust. Never commit the real .env file.

#[DJANGO]
SECRET_KEY=change-me-generate-with-python-c-django-core-management-commands-startproject
DEBUG=True
ALLOWED_HOSTS=127.0.0.1 localhost

# Frontend origins allowed by CORS, space separated
# Only needed when the API is called from another origin; the bundled
# dashboard is served by Django itself, so this can stay empty.
CORS_ORIGIN_WHITELIST=

# django-axes: brute-force protection
AXES_FAILURE_LIMIT=4
AXES_COOLOFF_TIME=2
AXES_RESET_ON_SUCCESS=True

#[CELERY]
CELERY_BROKER_REDIS_URL=redis://localhost:6379
CELERY_RESULT_BACKEND=redis://localhost:6379

#[POSTGRES]
# Leave POSTGRES_DB empty to fall back to SQLite (quick local start).
POSTGRES_DB=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432